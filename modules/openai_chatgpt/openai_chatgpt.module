<?php

/**
 * @file
 * Permissions for the OpenAI ChatGPT module.
 */

function openai_chatgpt_permission() {
  return [
    'access openai chatgpt' => [
      'title' => t('Permit access to using the OpenAI ChatGPT explorer.'),
    ],
  ];
}

/**
 * Implements hook_menu().
 */
function openai_chatgpt_menu() {
  $items = [];

  $items['admin/config/openai/chatgpt'] = [
    'title'            => 'OpenAi ChatGPT explorer',
    'description'      => 'Contains a form where you can experiment and test the OpenAI ChatGPT endpoint.',
    'page callback'    => 'backdrop_get_form',
    'page arguments'   => ['openai_chatgpt_form'],
    'access callback'  => 'user_access',
    'access arguments' => ['access openai chatgpt'],
    'weight' => -8,
  ];

  return $items;
}

/**
 * Implements the OpenAI ChatGPT form.
 */
function openai_chatgpt_form($form, &$form_state) {
  $ai_config = config('openai.settings');
  $providers_root = $ai_config->get('providers') ?: [];

  // If the built-in OpenAI provider is enabled, require its API key.
  $openai_enabled = !empty($providers_root['openai']['enabled']);
  if ($openai_enabled) {
    $openai_key_name = !empty($providers_root['openai']['api_key']) ? $providers_root['openai']['api_key'] : NULL;
    $apiKey = $openai_key_name ? key_get_key_value($openai_key_name) : NULL;
    if (empty($apiKey)) {
      form_set_error('', t('OpenAI provider is enabled but the API key is not set. Please configure the OpenAI API key in the AI settings.'));
      return $form;
    }
  }

  // Ensure at least one provider is enabled so the form has something to call.
  $any_enabled = FALSE;
  foreach ($providers_root as $p => $cfg) {
    if (!empty($cfg['enabled'])) { $any_enabled = TRUE; break; }
  }
  if (!$any_enabled) {
    form_set_error('', t('No AI provider is enabled. Please enable at least one provider in the OpenAI settings.'));
    return $form;
  }

  $form['text'] = [
    '#type' => 'textarea',
    '#title' => t('Ask the AI Assistant'),
    '#rows' => 5,
    '#description' => t('Enter your question or prompt below. When submitted, the selected AI provider will generate a response using its chat or completion endpoint. Response times may vary depending on model and provider load. Please allow up to 10–15 seconds for completion. Avoid exceeding your provider’s rate limits.'),
    '#required' => TRUE,
  ];

  $form['options'] = [
    '#type' => 'fieldset',
    '#title' => t('Options'),
    '#description' => t('Adjust settings for how the AI generates its response.'),
    '#collapsible' => TRUE,
    '#collapsed' => TRUE,
  ];

  $models = openai_get_all_chat_models();

  // Fallback: if no models found (e.g., adapter couldn't be instantiated),
  // try pulling Ollama models directly if Ollama is enabled.
  if (empty($models)) {
    $providers_root = config('openai.settings')->get('providers') ?: [];
    if (!empty($providers_root['ollama']['enabled'])) {
      $base = !empty($providers_root['ollama']['ollama_base_url']) ? $providers_root['ollama']['ollama_base_url'] : (!empty($providers_root['ollama']['base_url']) ? $providers_root['ollama']['base_url'] : NULL);
      if (function_exists('openai_ollama_get_models')) {
        $ollama_models = $base ? openai_ollama_get_models($base) : openai_ollama_get_models('http://localhost:11434');
        if (!empty($ollama_models)) {
          $group = [];
          foreach ($ollama_models as $m) {
            if (is_array($m)) {
              $id = isset($m['id']) ? $m['id'] : (isset($m['name']) ? $m['name'] : json_encode($m));
              $label = isset($m['display_name']) ? $m['display_name'] : $id;
            }
            else {
              $id = (string) $m;
              $label = $id;
            }
            $group['ollama/' . $id] = $label;
          }
          $models = [ openai_get_provider_label('ollama') => $group ];
        }
      }
    }
  }

  // Ensure $models is a options array for the select element.
  $options = $models;

  // Determine default. If the existing default isn't available, pick the
  // first model from the list (if any).
  $default_model = 'openai/gpt-4o-mini';

  // To check if default exists, we need to check both flat and grouped
  $flat_check = [];
  foreach ($models as $g_label => $g_items) {
    if (is_array($g_items)) {
      foreach ($g_items as $k => $v) { $flat_check[$k] = $v; }
    } else {
      $flat_check[$g_label] = $g_items;
    }
  }

  if (!empty($flat_check)) {
    if (!isset($flat_check[$default_model])) {
      if (isset($flat_check['gpt-4o-mini'])) {
        $default_model = 'gpt-4o-mini';
      } else {
        reset($flat_check);
        $default_model = key($flat_check);
      }
    }
  }
  else {
    $default_model = 'openai/gpt-4o-mini';
  }

  $form['options']['model'] = [
    '#type' => 'select',
    '#title' => t('Model'),
    '#options' => $options,
    '#default_value' => $default_model,
    '#description' => t('Select a model from any enabled AI provider. Available models and pricing vary by provider.'),
  ];

  $form['options']['temperature'] = [
    '#type' => 'number',
    '#title' => t('Temperature'),
    '#min' => 0,
    '#max' => 2,
    '#step' => .1,
    '#default_value' => '0.4',
    '#description' => t('Controls randomness. Higher values (e.g., 0.8) produce more creative responses, while lower values (e.g., 0.2) make output more consistent.'),
  ];

  $form['options']['max_tokens'] = [
    '#type' => 'number',
    '#title' => t('Max tokens'),
    '#min' => 1000,
    '#step' => 1,
    '#default_value' => '1000',
    '#description' => t('Maximum tokens to generate in the completion. The total (prompt + output) cannot exceed the model’s context limit.'),
  ];

  $form['options']['system'] = [
    '#type' => 'textarea',
    '#title' => t('System / Profile'),
    '#default_value' => 'You are a helpful assistant integrated into a Backdrop website. Be clear, concise, and polite. Ask follow-up questions when appropriate.',
    '#description' => t('Sets the assistant’s behavior or personality. Adjust this to influence how responses are phrased. Reload the form to change this mid-conversation.'),
    '#required' => TRUE,
  ];

  $form['response'] = [
    '#type' => 'textarea',
    '#title' => t('Response'),
    '#attributes' => [
      'readonly' => 'readonly',
    ],
    '#prefix' => '<div id="ai-chat-response">',
    '#suffix' => '</div>',
    '#description' => t('The AI’s response will appear above after submission.'),
  ];

  $form['actions'] = [
    '#type' => 'actions',
  ];

  $form['actions']['submit'] = [
    '#type' => 'submit',
    '#value' => t('Submit'),
    '#ajax' => [
      'callback' => 'openai_chatgpt_get_response',
      'wrapper' => 'ai-chat-response',
      'progress' => [
        'type' => 'throbber',
      ],
    ],
  ];

  return $form;
}

/**
 * Form validation handler.
 */
function openai_chatgpt_form_validate($form, &$form_state) {
  $model = $form_state['values']['model'];
  // Support provider-prefixed model ids like "provider/model". For validation
  // we only care about the model part (so token limit checks for OpenAI
  // models still apply).
  if (!empty($model) && strpos($model, '/') !== FALSE) {
    list(, $model) = explode('/', $model, 2);
  }
  $max_tokens = (int) $form_state['values']['max_tokens'];

  switch ($model) {
    case 'gpt-4':
    case 'gpt-4-0314':
      if ($max_tokens > 8192) {
        form_set_error('options][max_tokens', t('The model you have selected only supports a maximum of 8192 tokens. Please reduce the max token value to 8192 or lower.'));
      }
      break;
    case 'gpt-3.5-turbo':
    case 'gpt-3.5-turbo-0301':
      if ($max_tokens > 4096) {
        form_set_error('options][max_tokens', t('The model you have selected only supports a maximum of 4096 tokens. Please reduce the max token value to 4096 or lower.'));
      }
      break;
    case 'gpt-3.5-turbo-16k':
      if ($max_tokens > 16384) {
        form_set_error('options][max_tokens', t('The model you have selected only supports a maximum of 16384 tokens. Please reduce the max token value to 16384 or lower.'));
      }
      break;
    default:
      break;
  }
}

/**
 * Ajax callback for submitting the form.
 */
function openai_chatgpt_get_response($form, &$form_state) {
  $errors = form_get_errors();
  if (empty($errors)) {
    $storage = $form_state['storage'];
    $last_response = end($storage['messages']);
    $form['response']['#value'] = trim($last_response['content']) ?? t('No answer was provided.');
  }
  return $form['response'];
}

/**
 * Form submission handler.
 */
function openai_chatgpt_form_submit($form, &$form_state) {
  $text = $form_state['values']['text'];
  $system = $form_state['values']['system'];
  $model = $form_state['values']['model'];
  $temperature = $form_state['values']['temperature'];
  $max_tokens = $form_state['values']['max_tokens'];

  // Use the centralized helper to get the API for this model
  $stripped_model = '';
  $api = openai_get_api_for_model($model, $stripped_model);

  if (!$api) {
    backdrop_set_message(t('Unable to load API for the selected model.'), 'error');
    return;
  }

  // Ensure storage is initialized
  if (!isset($form_state['storage']) || !is_array($form_state['storage'])) {
    $form_state['storage'] = [];
  }

  if (!empty($form_state['storage']['messages'])) {
    $messages = $form_state['storage']['messages'];
    $messages[] = ['role' => 'user', 'content' => trim($text)];
  } else {
    $messages = [
      ['role' => 'system', 'content' => trim($system)],
      ['role' => 'user', 'content' => trim($text)],
    ];
  }

  // Use the stripped model ID (without provider prefix)
  $result = $api->chat($stripped_model, $messages, $temperature, $max_tokens);
  $messages[] = ['role' => 'assistant', 'content' => $result];
  $form_state['storage']['messages'] = $messages;
  $form_state['rebuild'] = TRUE;
}
