<?php

/**
 * @file
 * Admin form and handlers for provider-agnostic image generation (DALL·E / GPT-Image, etc.).
 */

use GuzzleHttp\Client as GuzzleClient;

/**
 * Permissions for the OpenAI DALL·E module.
 */
function openai_dalle_permission() {
  return [
    'access openai dalle' => [
      'title' => t('Use OpenAI DALL·E'),
    ],
  ];
}

/**
 * Implements hook_menu().
 */
function openai_dalle_menu() {
  $items = [];

  $items['admin/config/openai/dalle'] = [
    'title' => 'DALL·E / Image Generation',
    'description' => 'Generate images using models from your enabled AI providers (OpenAI, OpenRouter, etc.).',
    'page callback' => 'backdrop_get_form',
    'page arguments' => ['openai_dalle_form'],
    'access arguments' => ['access openai dalle'],
    'weight' => -6,
  ];

  return $items;
}

/**
 * Small helper to ensure $form_state['storage'] exists and return it by reference.
 *
 * @param array $form_state
 *   The form state array (by reference).
 *
 * @return array
 *   Reference to the storage array.
 */
function &_openai_dalle_get_storage(array &$form_state) {
  if (!isset($form_state['storage']) || !is_array($form_state['storage'])) {
    $form_state['storage'] = [];
  }
  return $form_state['storage'];
}

/**
 * Provides a form to interact with the image generation endpoint.
 */
function openai_dalle_form($form, &$form_state) {
  // Always ensure storage exists on build.
  $_ = &_openai_dalle_get_storage($form_state);

  $form['prompt'] = [
    '#type' => 'textarea',
    '#title' => t('Prompt'),
    '#description' => t('Describe the image you want to generate. Limits and safety rules vary by provider/model. For reference: DALL·E 2 ~1000 chars, DALL·E 3 ~4000 chars.'),
    '#required' => TRUE,
  ];

  // Get all image generation models from all enabled providers.
  $models = function_exists('openai_get_all_image_models') ? openai_get_all_image_models() : [];
  if (empty($models)) {
    backdrop_set_message(t('No image generation models are available from your configured providers. Please <a href="@url">configure a provider</a> in OpenAI settings.', ['@url' => url('admin/config/openai/settings')]), 'warning');
  }

  // Determine default.
  $default_model = 'openai/dall-e-3';

  // To check if default exists, we need to check both flat and grouped
  $flat_check = [];
  foreach ($models as $g_label => $g_items) {
    if (is_array($g_items)) {
      foreach ($g_items as $k => $v) { $flat_check[$k] = $v; }
    } else {
      $flat_check[$g_label] = $g_items;
    }
  }

  if (!empty($flat_check)) {
    if (!isset($flat_check[$default_model])) {
      if (isset($flat_check['dall-e-3'])) {
        $default_model = 'dall-e-3';
      } else {
        reset($flat_check);
        $default_model = key($flat_check);
      }
    }
  }

  $form['model'] = [
    '#type' => 'select',
    '#title' => t('Model'),
    '#options' => $models,
    '#default_value' => $default_model,
    '#description' => t('Choose an image generation model. Different providers and models may have different capabilities.'),
  ];

  $form['filename'] = [
    '#type' => 'textfield',
    '#title' => t('Filename'),
    '#default_value' => 'dalle_image',
    '#required' => TRUE,
    '#description' => t('The base filename to save the image as (extension will be added automatically).'),
  ];

  $form['response'] = [
    '#markup' => t('The generated image will be displayed below and saved to your file system.'),
  ];

  // AJAX wrapper for the result.
  $form['file'] = [
    '#prefix' => '<div id="openai-dalle-response">',
    '#suffix' => '</div>',
  ];

  $form['actions'] = [
    '#type' => 'actions',
  ];

  $form['actions']['submit'] = [
    '#type' => 'submit',
    '#value' => t('Submit'),
    '#ajax' => [
      'callback' => 'openai_dalle_get_response',
      'wrapper' => 'openai-dalle-response',
      'progress' => ['type' => 'throbber'],
    ],
  ];

  return $form;
}

/**
 * Form validation handler for the DALL·E form.
 */
function openai_dalle_form_validate($form, &$form_state) {
  $prompt = isset($form_state['values']['prompt']) ? $form_state['values']['prompt'] : '';
  $model  = isset($form_state['values']['model'])  ? $form_state['values']['model']  : '';

  // Strip provider prefix if present
  if (strpos($model, '/') !== FALSE) {
    $parts = explode('/', $model, 2);
    $model = $parts[1];
  }

  // Check prompt length for known models
  if ($model === 'dall-e-2' && mb_strlen($prompt) > 1000) {
    form_set_error('prompt', t('The input cannot exceed 1000 characters for the dall-e-2 model.'));
  }

  if ($model === 'dall-e-3' && mb_strlen($prompt) > 4000) {
    form_set_error('prompt', t('The input cannot exceed 4000 characters for the dall-e-3 model.'));
  }
}

/**
 * Renders the response wrapper (AJAX callback).
 *
 * @return array
 *   The modified 'file' element.
 */
function openai_dalle_get_response($form, &$form_state) {
  $storage = &_openai_dalle_get_storage($form_state);

  if (!empty($storage['fid'])) {
    $file = file_load($storage['fid']);
    if ($file) {
      $file_url = file_create_url($file->uri);
      $form['file']['#markup'] = t('
        <div class="openai-dalle-result">
          <p><strong>Generated Image:</strong></p>
          <img src="@file_url" alt="Generated Image" style="max-width: 100%; border: 1px solid #ccc; padding: 10px; display: block;" />
          <p><a href="@file_url" target="_blank" download>@filename</a></p>
        </div>',
        [
          '@file_url' => $file_url,
          '@filename' => $file->filename,
        ]
      );
    }
    else {
      $form['file']['#markup'] = t('The file could not be loaded.');
    }
  }
  else {
    $form['file']['#markup'] = t('No image generated yet.');
  }

  // Return just the wrapper element that matches #ajax['wrapper'].
  return $form['file'];
}

/**
 * Form submit handler for the image generation form.
 */
function openai_dalle_form_submit($form, &$form_state) {
  // Ensure storage exists before we write to it.
  $storage = &_openai_dalle_get_storage($form_state);

  // Get the model value (may be provider-prefixed like "openai/dall-e-3").
  $model_with_prefix = isset($form_state['values']['model']) ? $form_state['values']['model'] : 'openai/dall-e-3';

  // Use the centralized helper to get the API and stripped model.
  $stripped_model = '';
  $api = openai_get_api_for_model($model_with_prefix, $stripped_model);
  if (!$api) {
    form_set_error('', t('Unable to find provider for the selected model.'));
    return;
  }

  // Store provider (extract from prefix if present) for logging.
  $provider_prefix = 'openai';
  if (strpos($model_with_prefix, '/') !== FALSE) {
    $parts = explode('/', $model_with_prefix, 2);
    $provider_prefix = $parts[0];
  }
  $storage['provider'] = $provider_prefix;

  // Use the stripped model (without provider prefix) for API calls.
  $model = $stripped_model;

  // Retrieve form values.
  $prompt        = isset($form_state['values']['prompt']) ? $form_state['values']['prompt'] : '';
  $filename_base = isset($form_state['values']['filename']) ? $form_state['values']['filename'] : 'dalle_image';

  $file_scheme = file_default_scheme();
  $timestamp   = defined('REQUEST_TIME') ? REQUEST_TIME : time();

  try {
    // GPT-image models typically return base64-encoded JSON responses,
    // while DALL-E models return URLs. We handle both formats in the
    // response processing logic below.
    $is_gpt_image = (bool) preg_match('/^gpt-image/i', $model);
    $preferred_response_format = $is_gpt_image ? 'b64_json' : 'url';

    // Debug: log which API instance and provider we're about to call so we
    // can confirm whether OpenRouterAdapter::images() will be used.
    // Guard the watchdog logging with a try/catch so that if logging fails
    // for any reason it won't abort image generation. That's why there are
    // two try blocks: the outer one wraps the whole generation flow; this
    // inner one only protects the diagnostic logging call below.
    try {
      $api_class = is_object($api) ? get_class($api) : 'none';
      watchdog('openai_dalle', 'Invoking image generation using provider @provider (API class: @class), model @model, prefer format @fmt', [
        '@provider' => $storage['provider'],
        '@class' => $api_class,
        '@model' => $model,
        '@fmt' => $preferred_response_format,
      ], WATCHDOG_INFO);
    } catch (Exception $e) {
      // Ignore logging failures.
    }

    // Generate the image using the provider-agnostic API.
    // (OpenRouter commonly returns data URLs via 'url'.)
    $result = $api->images($model, $prompt, '1024x1024', $preferred_response_format);

    // If adapter returned nothing, try fallback using OpenAI provider if available.
    if ((is_array($result) && empty($result['data'])) || $result === NULL) {
      watchdog('openai_dalle', 'Primary provider returned no image data. Attempting fallback to OpenAI provider. Provider: @provider', ['@provider' => $storage['provider']], WATCHDOG_WARNING);
      if ($storage['provider'] !== 'openai') {
        try {
          $openai_api = openai_get_api('openai');
          if ($openai_api) {
            $fallback_format = $is_gpt_image ? 'b64_json' : 'url';
            $fallback_result = $openai_api->images($model, $prompt, '1024x1024', $fallback_format);
            if (is_array($fallback_result) && !empty($fallback_result['data'][0])) {
              $result = $fallback_result;
              watchdog('openai_dalle', 'Fallback to OpenAI provider succeeded.', [], WATCHDOG_INFO);
            }
            else {
              watchdog('openai_dalle', 'Fallback to OpenAI provider did not return image data (format: @fmt): @resp', ['@fmt' => $fallback_format, '@resp' => print_r($fallback_result, TRUE)], WATCHDOG_WARNING);
            }
          }
        }
        catch (Exception $e) {
          watchdog('openai_dalle', 'Fallback attempt to OpenAI failed: @msg', ['@msg' => $e->getMessage()], WATCHDOG_WARNING);
        }
      }
    }

    // Expect: ['data' => [ [ 'url' => ... ] or [ 'b64_json' => ... ] ]]
    if (!is_array($result) || empty($result['data']) || !isset($result['data'][0])) {
      watchdog('openai_dalle', 'Image API returned unexpected response for provider @provider: @resp', ['@provider' => $storage['provider'], '@resp' => print_r($result, TRUE)], WATCHDOG_ERROR);
      form_set_error('', t('Unexpected response from image API. No image data returned.'));
      return;
    }

    $data_item      = $result['data'][0];
    $ext            = 'png';

    // Case 1: URL present (may be https or data URL).
    if (!empty($data_item['url'])) {
      $url = $data_item['url'];

      if (is_string($url) && strpos($url, 'data:image/') === 0) {
        // Handle data URLs (OpenRouter’s image output).
        $parsed = openai_dalle_parse_data_url($url);
        if (!$parsed) {
          form_set_error('', t('Could not parse the image data URL returned by the provider.'));
          return;
        }
        $image_contents = $parsed['data'];
        $ext            = $parsed['ext']; // png/jpeg/webp
      }
      else {
        // Regular http(s) URL — download it.
        $image_contents = @file_get_contents($url);
        if ($image_contents === FALSE || $image_contents === NULL) {
          watchdog('openai_dalle', 'Failed to download image from URL: @url - provider response: @resp', ['@url' => $url, '@resp' => print_r($result, TRUE)], WATCHDOG_ERROR);
          form_set_error('', t('Failed to download the generated image from the returned URL.'));
          return;
        }
        // Sniff mime → extension.
        $finfo     = new finfo(FILEINFO_MIME_TYPE);
        $mime_type = $finfo->buffer($image_contents);
        if ($mime_type === 'image/jpeg') { $ext = 'jpg'; }
        elseif ($mime_type === 'image/png') { $ext = 'png'; }
        elseif ($mime_type === 'image/webp') { $ext = 'webp'; }
      }
    }
    // Case 2: Base64 JSON present (e.g., GPT-Image).
    elseif (!empty($data_item['b64_json'])) {
      $b64 = $data_item['b64_json'];
      $image_contents = base64_decode($b64);
      if ($image_contents === FALSE) {
        watchdog('openai_dalle', 'Failed to decode base64 image payload for model @model. Provider response: @resp', ['@model' => $model, '@resp' => print_r($data_item, TRUE)], WATCHDOG_ERROR);
        form_set_error('', t('Failed to decode the Base64 image data returned by the model.'));
        return;
      }
      $finfo     = new finfo(FILEINFO_MIME_TYPE);
      $mime_type = $finfo->buffer($image_contents);
      if ($mime_type === 'image/jpeg') { $ext = 'jpg'; }
      elseif ($mime_type === 'image/png') { $ext = 'png'; }
      elseif ($mime_type === 'image/webp') { $ext = 'webp'; }
    }
    else {
      // Case 3: Try to find any URL in the payload.
      $url = openai_dalle_find_url_in_response($result);
      if (!empty($url)) {
        if (strpos($url, 'data:image/') === 0) {
          $parsed = openai_dalle_parse_data_url($url);
          if (!$parsed) {
            form_set_error('', t('Could not parse the image data URL returned by the provider.'));
            return;
          }
          $image_contents = $parsed['data'];
          $ext            = $parsed['ext'];
        }
        else {
          $image_contents = @file_get_contents($url);
          if ($image_contents === FALSE || $image_contents === NULL) {
            watchdog('openai_dalle', 'Failed to download image from discovered URL: @url - provider response: @resp', ['@url' => $url, '@resp' => print_r($result, TRUE)], WATCHDOG_ERROR);
            form_set_error('', t('Failed to download the generated image from the returned URL.'));
            return;
          }
          $finfo     = new finfo(FILEINFO_MIME_TYPE);
          $mime_type = $finfo->buffer($image_contents);
          if ($mime_type === 'image/jpeg') { $ext = 'jpg'; }
          elseif ($mime_type === 'image/png') { $ext = 'png'; }
          elseif ($mime_type === 'image/webp') { $ext = 'webp'; }
        }
      }
      else {
        watchdog('openai_dalle', 'Image API returned no URL (and no supported base64). Full response: @resp', ['@resp' => print_r($result, TRUE)], WATCHDOG_ERROR);
        form_set_error('', t('Unexpected response from image API. The provider did not return an image.'));
        return;
      }
    }

    // Build destination and ensure directory exists.
    $unique_filename = $filename_base . '-' . $timestamp . '.' . $ext;
    $destination     = $file_scheme . '://openai_dalle/' . $unique_filename;

    $directory = backdrop_dirname($destination);
    file_prepare_directory($directory, FILE_CREATE_DIRECTORY | FILE_MODIFY_PERMISSIONS);

    // Save the file.
    $file = file_save_data($image_contents, $destination, FILE_EXISTS_RENAME);
    if ($file) {
      file_usage_add($file, 'openai_dalle', 'module', $file->fid);
      $storage['filename'] = $file->filename;
      $storage['filepath'] = file_create_url($file->uri);
      $storage['fid']      = $file->fid;
      backdrop_set_message(t('Image generated and saved successfully!'));
    }
    else {
      watchdog('openai_dalle', 'file_save_data failed when saving image to @dest', ['@dest' => $destination], WATCHDOG_ERROR);
      form_set_error('', t('Failed to save the image to the file system.'));
    }
  }
  catch (Exception $e) {
    watchdog('openai_dalle', 'Image generation exception: @msg', ['@msg' => $e->getMessage()], WATCHDOG_ERROR);
    form_set_error('', t('Error generating image: @message', ['@message' => $e->getMessage()]));
  }

  // Rebuild to refresh the AJAX wrapper with the new file info.
  $form_state['rebuild'] = TRUE;
}

/**
 * Recursively search a provider response array for the first image URL.
 *
 * @param mixed $data
 *   The response to search (array or string).
 *
 * @return string|null
 *   The first URL found, or NULL if none.
 */
function openai_dalle_find_url_in_response($data) {
  // If it's a string, try to extract a URL.
  if (is_string($data)) {
    if (filter_var(trim($data), FILTER_VALIDATE_URL)) {
      return trim($data);
    }
    if (preg_match('/https?:\/\/[^\s\)\"]+\.(png|jpg|jpeg|webp|gif)/i', $data, $m)) {
      return $m[0];
    }
    // Also allow raw data URLs here.
    if (strpos($data, 'data:image/') === 0) {
      return $data;
    }
    return NULL;
  }

  // If it's an array, walk it.
  if (is_array($data)) {
    foreach ($data as $item) {
      $found = openai_dalle_find_url_in_response($item);
      if (!empty($found)) {
        return $found;
      }
    }
  }

  return NULL;
}

/**
 * Parse a data URL (data:image/...;base64,....) into ['ext' => 'png|jpg|webp', 'data' => <binary>].
 *
 * @param string $data_url
 * @return array|null
 */
function openai_dalle_parse_data_url($data_url) {
  if (!is_string($data_url) || strpos($data_url, 'data:image/') !== 0) {
    return NULL;
  }
  $semi = strpos($data_url, ';');
  $comma = strpos($data_url, ',');
  if ($semi === FALSE || $comma === FALSE || $comma <= $semi) {
    return NULL;
  }
  $mime = substr($data_url, 5, $semi - 5); // e.g., image/png
  $b64  = substr($data_url, $comma + 1);

  $binary = base64_decode($b64);
  if ($binary === FALSE) {
    return NULL;
  }

  // Determine extension from mime.
  $ext = 'png';
  if ($mime === 'image/jpeg' || $mime === 'image/jpg') { $ext = 'jpg'; }
  elseif ($mime === 'image/png') { $ext = 'png'; }
  elseif ($mime === 'image/webp') { $ext = 'webp'; }

  return ['ext' => $ext, 'data' => $binary];
}
