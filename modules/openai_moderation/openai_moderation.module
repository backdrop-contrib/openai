<?php

/**
 * @file
 * Permissions and menu items for the OpenAI Moderation module.
 */

function openai_moderation_permission() {
  return [
    'access openai moderation' => [
      'title' => t('Use OpenAI Moderation'),
    ],
  ];
}

/**
 * Implements hook_menu().
 */
function openai_moderation_menu() {
  $items = [];

  $items['admin/config/openai/moderation'] = [
    'title' => 'OpenAI Moderation',
    'description' => 'Test OpenAI content moderation with different models.',
    'page callback' => 'backdrop_get_form',
    'page arguments' => ['openai_moderation_form'],
    'access callback' => 'user_access',
    'access arguments' => ['access openai moderation'],
    'weight' => -5,
  ];

  return $items;
}

/**
 * Defines a form to test OpenAI content moderation.
 */
function openai_moderation_form($form, &$form_state) {
  // Ensure parent module functions are available
  if (!function_exists('openai_get_api')) {
    backdrop_set_message(t('OpenAI module functions are not available. Please ensure the OpenAI module is enabled.'), 'error');
    return $form;
  }

  $config = config('openai.settings');

  // Get all enabled providers
  $providers_root = $config->get('providers') ?: [];

  // Check if any provider is enabled
  $any_enabled = FALSE;
  foreach ($providers_root as $p => $cfg) {
    if (!empty($cfg['enabled'])) {
      $any_enabled = TRUE;
      break;
    }
  }

  if (!$any_enabled) {
    // Use l() to build the link and concatenate to avoid embedding HTML in t().
    $link = l(t('configure a provider'), 'admin/config/openai/settings');
    backdrop_set_message(t('No providers are enabled.') . ' ' . $link, 'warning');
    return $form;
  }

  // Get moderation models from all enabled providers
  $moderation_models = openai_get_all_moderation_models();

  // If no moderation models are available, show a message
  if (empty($moderation_models)) {
    $link = l(t('enable and configure OpenAI'), 'admin/config/openai/settings');
    backdrop_set_message(t('No moderation models are available from your configured providers. Moderation is currently only supported by the OpenAI provider.') . ' ' . $link, 'warning');
    return $form;
  }

  $form['text'] = array(
    '#type' => 'textarea',
    '#title' => t('Text to Moderate'),
    '#description' => t('Enter the text you want to check for policy violations. OpenAI will analyze this content against their usage policies.'),
    '#required' => TRUE,
    '#rows' => 5,
  );

  // Set a default model value (prefer OpenAI's omni-moderation-latest if present).
  $default_model = 'openai/omni-moderation-latest';

  // To check if default exists, we need to check both flat and grouped
  $flat_check = [];
  foreach ($moderation_models as $g_label => $g_items) {
    if (is_array($g_items)) {
      foreach ($g_items as $k => $v) { $flat_check[$k] = $v; }
    } else {
      $flat_check[$g_label] = $g_items;
    }
  }

  if (!empty($flat_check)) {
    if (!isset($flat_check[$default_model])) {
      reset($flat_check);
      $default_model = key($flat_check);
    }
  }

  $form['model'] = array(
    '#type' => 'select',
    '#title' => t('Moderation Model'),
    '#options' => $moderation_models,
    '#default_value' => $default_model,
    '#description' => t('Select which moderation model to use for analysis.'),
  );

  $form['response'] = [
    '#prefix' => '<div id="openai-moderation-response">',
    '#suffix' => '</div>',
  ];

  $form['actions'] = array('#type' => 'actions');
  $form['actions']['submit'] = array(
    '#type' => 'submit',
    '#value' => t('Check Content'),
    '#ajax' => [
      'callback' => 'openai_moderation_get_response',
      'wrapper' => 'openai-moderation-response',
      'progress' => [
        'type' => 'throbber',
      ],
    ],
  );

  return $form;
}

/**
 * AJAX callback for moderation form submission.
 */
function openai_moderation_get_response($form, &$form_state) {
  $errors = form_get_errors();

  if (empty($errors)) {
    // Check if we have results in storage
    if (!empty($form_state['storage']['moderation_result'])) {
      $result = $form_state['storage']['moderation_result'];

      $form['response']['#markup'] = theme('openai_moderation_result', ['result' => $result]);
    } else {
      $form['response']['#markup'] = t('No moderation result available.');
    }
  } else {
    // Display form errors
    $error_messages = [];
    foreach ($errors as $error) {
      $error_messages[] = $error;
    }
    $form['response']['#markup'] = t('Error: @errors', ['@errors' => implode('; ', $error_messages)]);
  }

  return $form['response'];
}

/**
 * Form submission handler for the moderation form.
 */
function openai_moderation_form_submit($form, &$form_state) {
  $text = $form_state['values']['text'];
  $model = $form_state['values']['model'];

  // If the model is provider-prefixed (provider/model), extract both parts.
  $provider_id = NULL;
  $stripped_model = $model;
  if (strpos($model, '/') !== FALSE) {
    list($provider_id, $stripped_model) = explode('/', $model, 2);
  }

  // If provider wasn't extracted from the selected value, try to detect it.
  if (empty($provider_id)) {
    $config = config('openai.settings');
    $provider_id = 'openai'; // fallback default
    $enabled_providers = $config->get('enabled_providers') ?: [];
    foreach ($enabled_providers as $pid => $enabled) {
      if ($enabled) {
        $api_try = openai_get_api($pid);
        if ($api_try) {
          $models = $api_try->getModerationModels();
          if (isset($models[$stripped_model])) {
            $provider_id = $pid;
            break;
          }
        }
      }
    }
  }

  $api = openai_get_api($provider_id);

  if (!$api) {
    form_set_error('', t('Could not initialize API for selected model.'));
    return;
  }

  try {
    // Pass the stripped model id (without provider prefix) to the adapter.
    $result = $api->moderation($text, $stripped_model);

    // Store the result for the AJAX callback
    $form_state['storage']['moderation_result'] = $result;
    $form_state['rebuild'] = TRUE;

  } catch (Exception $e) {
    form_set_error('', t('Error during moderation: @message', ['@message' => $e->getMessage()]));
  }
}

/**
 * Implements hook_theme().
 */
function openai_moderation_theme() {
  return [
    'openai_moderation_result' => [
      'variables' => ['result' => NULL],
      'function' => 'theme_openai_moderation_result',
    ],
  ];
}

/**
 * Theme function for moderation results.
 */
function theme_openai_moderation_result($variables) {
  $result = $variables['result'];

  if (empty($result) || !isset($result['results'])) {
    return '<p>' . t('Invalid moderation result.') . '</p>';
  }

  $output = '<div class="openai-moderation-result">';
  $output .= '<h3>' . t('Moderation Results') . '</h3>';

  foreach ($result['results'] as $index => $moderation) {
    $flagged = $moderation['flagged'] ?? FALSE;
    $status_class = $flagged ? 'flagged' : 'safe';

    $output .= '<div class="moderation-item ' . $status_class . '">';
    $output .= '<h4>' . t('Overall Status: ') . '</h4>';
    $output .= '<p class="status-' . $status_class . '">';
    $output .= $flagged ?
      '<strong style="color: red;">' . t('⚠ Content Flagged') . '</strong>' :
      '<strong style="color: green;">' . t('✓ Content Safe') . '</strong>';
    $output .= '</p>';

    if (isset($moderation['categories'])) {
      $output .= '<h4>' . t('Category Analysis:') . '</h4>';
      $output .= '<ul class="moderation-categories">';

      foreach ($moderation['categories'] as $category => $violated) {
        $category_display = ucwords(str_replace(['_', '-'], ' ', $category));
        $status_icon = $violated ? '❌' : '✅';
        $status_text = $violated ? t('Violated') : t('Safe');

        $output .= '<li>';
        $output .= '<strong>' . $category_display . ':</strong> ';
        $output .= $status_icon . ' ' . $status_text;
        $output .= '</li>';
      }

      $output .= '</ul>';
    }

    if (isset($moderation['category_scores'])) {
      $output .= '<h4>' . t('Confidence Scores:') . '</h4>';
      $output .= '<ul class="moderation-scores">';

      foreach ($moderation['category_scores'] as $category => $score) {
        $category_display = ucwords(str_replace(['_', '-'], ' ', $category));
        $percentage = is_numeric($score) ? round(floatval($score) * 100, 2) : 0.0;

        $output .= '<li>';
        $output .= '<strong>' . $category_display . ':</strong> ';
        $output .= $percentage . '%';
        $output .= '</li>';
      }

      $output .= '</ul>';
    }

    $output .= '</div>';
  }

  $output .= '</div>';

  // Add some basic CSS
  $output .= '<style>
    .openai-moderation-result { margin: 20px 0; padding: 15px; border: 1px solid #ddd; border-radius: 5px; }
    .moderation-item.flagged { border-left: 4px solid #d32f2f; background-color: #ffebee; }
    .moderation-item.safe { border-left: 4px solid #388e3c; background-color: #e8f5e8; }
    .moderation-categories li, .moderation-scores li { margin: 5px 0; }
    .status-flagged { color: #d32f2f; }
    .status-safe { color: #388e3c; }
  </style>';

  return $output;
}
