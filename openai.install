<?php

/**
 * Implements hook_schema().
 */
function openai_schema() {
  $schema['openai_log'] = [
    'description' => 'Stores logs of OpenAI API requests and responses.',
    'fields' => [
      'id' => [
        'description' => 'The primary identifier for a log entry.',
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'timestamp' => [
        'description' => 'The Unix timestamp when the log entry was created.',
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
      ],
      'uid' => [
        'description' => 'The user ID who performed the operation.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
      'module' => [
        'description' => 'The module that initiated the request.',
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
        'default' => '',
      ],
      'operation' => [
        'description' => 'The operation being performed (e.g., chat, completions).',
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
        'default' => '',
      ],
      'model' => [
        'description' => 'The model used for the request.',
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
        'default' => '',
      ],
      'provider' => [
        'description' => 'The provider used for the request.',
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
        'default' => '',
      ],
      'request_data' => [
        'description' => 'The data sent in the request (JSON).',
        'type' => 'text',
        'size' => 'big',
      ],
      'response_data' => [
        'description' => 'The data received in the response (JSON).',
        'type' => 'text',
        'size' => 'big',
      ],
      'status' => [
        'description' => 'The status of the request (1 for success, 0 for failure).',
        'type' => 'int',
        'size' => 'tiny',
        'not null' => TRUE,
        'default' => 0,
      ],
      'duration' => [
        'description' => 'The duration of the request in seconds.',
        'type' => 'float',
        'size' => 'big',
        'not null' => TRUE,
        'default' => 0,
      ],
      'error_message' => [
        'description' => 'The error message if the request failed.',
        'type' => 'text',
      ],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'timestamp' => ['timestamp'],
      'module' => ['module'],
      'operation' => ['operation'],
    ],
  ];

  return $schema;
}

/**
 * Implements hook_requirements().
 */
function openai_requirements($phase) {
  $requirements = [];

  if ($phase == 'runtime') {
    // Create a default container entry.
    $requirements['openai'] = [
      'title' => t('OpenAI Integration'),
    ];

    $config = config_get('openai.settings');
    $providers_config = isset($config['providers']) ? $config['providers'] : [];

    // If Key module is not available, it's required for most use cases.
    if (!module_exists('key')) {
      $requirements['openai']['value'] = t('Key module not enabled');
      $requirements['openai']['severity'] = REQUIREMENT_ERROR;
      $requirements['openai']['description'] = t(
        'The OpenAI module requires the Key module to securely manage API keys. Enable the Key module from the <a href="@modules">modules page</a>.',
        ['@modules' => url('admin/modules')]
      );
      return $requirements;
    }

    // Check if any provider is enabled and working.
    $working_providers = [];
    $failed_providers = [];

    if (!empty($providers_config) && is_array($providers_config)) {
      foreach ($providers_config as $provider_id => $provider_cfg) {
        // Skip providers that are not enabled.
        if (empty($provider_cfg['enabled'])) {
          continue;
        }

        // Try to get a working API instance for this provider.
        try {
          $api = openai_get_api($provider_id);
          if ($api) {
            $working_providers[] = $provider_id;
          }
          else {
            $failed_providers[] = $provider_id;
          }
        }
        catch (Exception $e) {
          $failed_providers[] = $provider_id;
        }
      }
    }

    // If at least one provider is working, report OK.
    if (!empty($working_providers)) {
      $provider_labels = array_map('openai_get_provider_label', $working_providers);
      $requirements['openai']['value'] = t('Providers configured and working: @providers', [
        '@providers' => implode(', ', $provider_labels),
      ]);
      $requirements['openai']['severity'] = REQUIREMENT_OK;
      return $requirements;
    }

    // If providers are configured but none are working, report ERROR.
    if (!empty($failed_providers)) {
      $provider_labels = array_map('openai_get_provider_label', $failed_providers);
      $requirements['openai']['value'] = t('Provider configuration incomplete');
      $requirements['openai']['severity'] = REQUIREMENT_ERROR;
      $requirements['openai']['description'] = t(
        'The following providers are enabled but could not be initialized: @providers. Verify that API keys are configured and valid on the <a href="@settings">OpenAI settings</a> page.',
        [
          '@providers' => implode(', ', $provider_labels),
          '@settings' => url('admin/config/openai/settings'),
        ]
      );
      return $requirements;
    }

    // No providers enabled: warn but don't error.
    $requirements['openai']['value'] = t('No providers configured');
    $requirements['openai']['severity'] = REQUIREMENT_WARNING;
    $requirements['openai']['description'] = t(
      'No AI providers are currently enabled. The OpenAI module can be installed without active providers; features requiring an API will remain disabled. Configure providers on the <a href="@settings">OpenAI settings</a> page.',
      ['@settings' => url('admin/config/openai/settings')]
    );
  }

  return $requirements;
}

/**
 * Implements hook_uninstall().
 */
function openai_uninstall() {
  // Delete configuration on uninstall.
  config('openai.settings')->delete();
}

/**
 * Add the openai_log table for API logging.
 */
function openai_update_1000() {
  $schema = openai_schema();
  if (!db_table_exists('openai_log')) {
    db_create_table('openai_log', $schema['openai_log']);
  }
}
