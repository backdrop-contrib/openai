<?php

/**
 * Load a single log entry.
 */
function openai_log_load($id) {
  $log = entity_load('openai_log', array($id));
  return $log ? reset($log) : FALSE;
}

/**
 * Implements hook_config_info().
 */
function openai_config_info() {
  return [
    'openai.settings' => [
      'label' => t('OpenAI Settings'),
      'group' => t('Configuration'),
    ],
  ];
}

/**
 * Implements hook_autoload_info().
 */
function openai_autoload_info() {
  return [
    'AIClientInterface' => 'includes/AIClientInterface.php',
    'OpenAIApi'         => 'includes/OpenAIApi.php',
    'OpenAIAdapter'     => 'includes/OpenAIAdapter.php',
    'OpenAILog'         => 'includes/OpenAILog.inc',
    'StringHelper'      => 'includes/StringHelper.php',
  ];
}

/**
 * Implements hook_entity_info().
 */
function openai_entity_info() {
  $info['openai_log'] = array(
    'label' => t('OpenAI Log'),
    'controller class' => 'DefaultEntityController',
    'entity class' => 'OpenAILog',
    'base table' => 'openai_log',
    'entity keys' => array(
      'id' => 'id',
    ),
    'module' => 'openai',
  );

  return $info;
}

/**
 * Implements hook_cron().
 */
function openai_cron() {
  $max_age = config_get('openai.settings', 'openai_log_max_age');
  if ($max_age > 0) {
    $cutoff = REQUEST_TIME - $max_age;
    db_delete('openai_log')
      ->condition('timestamp', $cutoff, '<')
      ->execute();
  }
}

/**
 * Implements hook_init().
 */
function openai_init() {
  // Only run on admin pages.
  if (!path_is_admin(current_path())) {
    return;
  }

  // If Key module isn't enabled, the module cannot work.
  if (!module_exists('key')) {
    $message = t('The Key module is not enabled. The OpenAI module requires the Key module to securely manage API keys. Please enable it from the <a href="@modules">modules page</a>.',
      [
        '@modules' => url('admin/modules'),
      ]
    );
    backdrop_set_message($message, 'error');
    return;
  }

  // Check if any configured provider is working.
  $config = config_get('openai.settings');
  $providers_config = isset($config['providers']) ? $config['providers'] : [];

  // Iterate through all enabled providers and see if any is working.
  $any_working = FALSE;
  $failed_providers = [];

  if (!empty($providers_config) && is_array($providers_config)) {
    foreach ($providers_config as $provider_id => $provider_cfg) {
      // Skip providers that are not enabled.
      if (empty($provider_cfg['enabled'])) {
        continue;
      }

      try {
        $api = openai_get_api($provider_id);
        if ($api) {
          $any_working = TRUE;
          break;
        }
        else {
          $failed_providers[] = $provider_id;
        }
      }
      catch (Exception $e) {
        $failed_providers[] = $provider_id;
      }
    }
  }

  // If at least one provider is working, nothing to do.
  if ($any_working) {
    return;
  }

  // If providers are configured but none are working, show error.
  if (!empty($failed_providers)) {
    $provider_labels = array_map('openai_get_provider_label', $failed_providers);
    $message = t('The following AI providers are enabled but could not be initialized: @providers. Verify that API keys are configured and valid on the <a href="@settings">OpenAI settings</a> page.',
      [
        '@providers' => implode(', ', $provider_labels),
        '@settings' => url('admin/config/openai/settings'),
      ]
    );
    backdrop_set_message($message, 'error');
  }
}


/**
 * Implements hook_menu().
 */
function openai_menu() {
  $items = [];

  // Make OpenAI a proper config category, like "Content authoring" etc.
  $items['admin/config/openai'] = [
    'title' => 'OpenAI',
    'description' => 'Configure OpenAI integration.',
    // Use the module's overview page so we can render provider links and
    // helpful descriptions. Using system_admin_config_page here prevented
    // our custom overview from running in some site configurations.
    'page callback' => 'openai_admin_overview',
    'access arguments' => ['administer site configuration'],
    'type' => MENU_NORMAL_ITEM,
  ];

  // Child "Settings" page under that category.
  $items['admin/config/openai/settings'] = [
    'title' => 'Settings',
    'description' => 'Manage OpenAI settings, API keys, and organization ID.',
    'page callback' => 'backdrop_get_form',
    'page arguments' => ['openai_settings_form'],
    'access arguments' => ['administer site configuration'],
    'type' => MENU_NORMAL_ITEM,
    'weight' => -10,
  ];

  $items['admin/reports/openai-logs'] = [
    'title' => 'OpenAI Logs',
    'description' => 'View detailed logs of AI API requests and responses.',
    'page callback' => 'openai_log_list_page',
    'access arguments' => ['administer site configuration'],
    'file' => 'openai.logs.pages.inc',
    'type' => MENU_NORMAL_ITEM,
  ];

  $items['admin/reports/openai-logs/%openai_log'] = [
    'title' => 'AI Log entry',
    'page callback' => 'openai_log_view_page',
    'page arguments' => [3],
    'access arguments' => ['administer site configuration'],
    'file' => 'openai.logs.pages.inc',
  ];

  return $items;
}


/**
 * Page callback for the OpenAI admin overview page.
 * Dynamically fetches all OpenAI-related configuration pages.
 */
function openai_admin_overview() {
  $items = [];

  // Fetch all menu paths that start with "admin/config/openai/" but ignore tabs.
  $menu_links = db_query("SELECT path, title, description, tab_parent FROM {menu_router} WHERE path LIKE :path ORDER BY title ASC", [':path' => 'admin/config/openai/%'])->fetchAll();

  foreach ($menu_links as $link) {
    // Ensure it’s not a tab item.
    if (!empty($link->tab_parent)) {
      continue;
    }

    $path = $link->path;
    $title = !empty($link->title) ? t($link->title) : t(ucwords(str_replace('_', ' ', basename($path))));
    $description = !empty($link->description) ? t($link->description) : '';

    // Skip the main OpenAI page itself.
    if ($path === 'admin/config/openai') {
      continue;
    }

    // Skip operation paths (edit, delete, add with wildcards)
    // These should only appear as operations on their parent pages
    if (preg_match('/(\/edit|\/delete|\/add)$/', $path) || strpos($path, '%') !== FALSE) {
      continue;
    }

    // Generate a link and description.
    $link_markup = '<dt>' . l($title, $path) . '</dt><dd>' . $description . '</dd>';

    // Store in array for sorting.
    $items[$title] = $link_markup;
  }

  // Ensure "Settings" appears at the top.
  ksort($items);
  if (isset($items['Settings'])) {
    $settings = $items['Settings'];
    unset($items['Settings']);
    $items = ['Settings' => $settings] + $items;
  }

  return '<dl>' . implode("\n", $items) . '</dl>';
}


/**
 * Settings form for OpenAI configuration.
 */
function openai_settings_form($form, &$form_state) {
  $form = [];
  $form['#config'] = 'openai.settings';
  $form['#submit'][] = 'openai_settings_form_submit';

  // Fetch available keys from the Key module.
  $available_keys = key_get_key_names_as_options();

  // Read central providers configuration (single source of truth).
  $providers_root = config_get('openai.settings', 'providers') ?: [];

  // Get available providers (do not force including the built-in OpenAI
  // provider here — use openai_get_providers() which defaults to not
  // merging the built-in provider unless explicitly requested).
  $providers = openai_get_providers();

  $form['providers'] = [
    '#type' => 'fieldset',
    '#title' => t('AI Providers'),
    '#description' => t('Select which AI providers to enable. You can enable multiple providers and use different models from each.'),
    '#collapsible' => FALSE,
    '#tree' => TRUE,
  ];

  $form['logging'] = [
    '#type' => 'fieldset',
    '#title' => t('API Logging'),
    '#description' => t('Configure detailed logging of all AI API requests and responses.'),
    '#collapsible' => TRUE,
    '#collapsed' => FALSE,
  ];

  $form['logging']['openai_log_enabled'] = [
    '#type' => 'checkbox',
    '#title' => t('Enable API logging'),
    '#default_value' => config_get('openai.settings', 'openai_log_enabled') ?? FALSE,
    '#description' => t('If enabled, AI tasks (chat, completions, etc.) will be logged to the database. Model discovery calls are never logged to avoid clutter.'),
  ];

  $form['logging']['openai_log_max_age'] = [
    '#type' => 'select',
    '#title' => t('Discard logs older than'),
    '#default_value' => config_get('openai.settings', 'openai_log_max_age') ?? 2592000,
    '#options' => [
      0 => t('Never'),
      3600 => t('1 hour'),
      86400 => t('1 day'),
      604800 => t('1 week'),
      2592000 => t('1 month'),
      15552000 => t('6 months'),
      31536000 => t('1 year'),
    ],
    '#description' => t('Older log entries will be automatically deleted during cron runs.'),
    '#states' => [
      'visible' => [
        ':input[name="openai_log_enabled"]' => ['checked' => TRUE],
      ],
    ],
  ];

  // Build a combined list of all providers including OpenAI
  $all_providers = $providers;
  $all_providers['openai'] = [
    'label' => t('OpenAI'),
    'description' => t('Access GPT-4, GPT-3.5, DALL-E, and other OpenAI models directly.'),
    'website' => 'https://platform.openai.com/',
  ];

  // Sort all providers alphabetically by label
  uasort($all_providers, function($a, $b) {
    $label_a = isset($a['label']) ? (string)$a['label'] : '';
    $label_b = isset($b['label']) ? (string)$b['label'] : '';
    return strcasecmp($label_a, $label_b);
  });

  // Add each provider (including OpenAI) in alphabetical order
  foreach ($all_providers as $provider_id => $provider_info) {
    if ($provider_id === 'openai') {
      // Add OpenAI as a provider option
      $default_openai_enabled = isset($providers_root['openai']['enabled']) ? (bool) $providers_root['openai']['enabled'] : FALSE;
      $form['providers']['enabled_providers_openai'] = [
        '#type' => 'checkbox',
        '#title' => t('OpenAI'),
        '#description' => t('Access GPT-4, GPT-3.5, DALL-E, and other OpenAI models directly. <a href="https://platform.openai.com/" target="_blank">Learn more</a>'),
        '#default_value' => $default_openai_enabled ? 1 : 0,
      ];

      $form['providers']['openai_settings'] = [
        '#type' => 'container',
        '#title' => t('OpenAI Settings'),
        '#states' => [
          'visible' => [
            ':input[name="providers[enabled_providers_openai]"]' => ['checked' => TRUE],
          ],
        ],
      ];

      $form['providers']['openai_settings']['api_key_openai'] = [
        '#type' => 'key_select',
        '#title' => t('OpenAI API Key'),
        '#default_value' => !empty($providers_root['openai']['api_key']) ? $providers_root['openai']['api_key'] : '',
        '#options' => $available_keys,
        '#key_filters' => ['type' => 'authentication'],
        '#description' => t('Get your API key from <a href="https://platform.openai.com/api-keys" target="_blank">OpenAI Platform</a>'),
      ];

      // Show available OpenAI models only when the OpenAI provider is enabled
      if (!empty($default_openai_enabled)) {
        $openai_key = !empty($providers_root['openai']['api_key']) ? $providers_root['openai']['api_key'] : '';
        if (!empty($openai_key)) {
          try {
            $apiKey = key_get_key_value($openai_key);
            if (!empty($apiKey)) {
              $api = new OpenAIApi($apiKey);
              $models = $api->getModels();
              if (!empty($models)) {
                $form['providers']['openai_settings']['openai_models'] = [
                  '#type' => 'markup',
                  '#markup' => '<details class="openai-models"><summary><strong>' . t('OpenAI — @count models', ['@count' => count($models)]) . '</strong></summary>' .
                    '<div style="max-height: 300px; overflow-y: auto; font-size: 0.9em; line-height: 1.4; padding:0.5em 0;">' .
                    implode('<br/>', array_map('check_plain', $models)) .
                    '</div></details>',
                  '#weight' => 10,
                ];
              }
            }
          }
          catch (Exception $e) {
            // Silently fail - models will show after save
          }
        }
      }
    }
    else {
      // Add other providers
      $default_enabled = isset($providers_root[$provider_id]['enabled']) ? (bool) $providers_root[$provider_id]['enabled'] : FALSE;
      $form['providers']['enabled_providers_' . $provider_id] = [
        '#type' => 'checkbox',
        '#title' => $provider_info['label'],
        '#description' => $provider_info['description'] . ' <a href="' . $provider_info['website'] . '" target="_blank">Learn more</a>',
        '#default_value' => $default_enabled ? 1 : 0,
      ];

      // Use a non-collapsible container for provider settings and show it
      // inline when the provider checkbox is checked.
      $form['providers'][$provider_id . '_settings'] = [
        '#type' => 'container',
        '#title' => t('@provider Settings', ['@provider' => $provider_info['label']]),
        '#states' => [
          'visible' => [
            ':input[name="providers[enabled_providers_' . $provider_id . ']"]' => ['checked' => TRUE],
          ],
        ],
      ];

      // Let providers add their own settings via alter hooks (by reference).
      $context = ['provider' => $provider_id, 'form' => &$form];
      // Allow provider modules to alter the settings array by reference so
      // they can add custom elements (e.g., api_key_openrouter) and set
      // descriptions. Use a variable to pass by reference.
      $provider_settings =& $form['providers'][$provider_id . '_settings'];
      backdrop_alter('openai_provider_settings', $provider_settings, $context);

      // If the provider module added an api_key element and provided a
      // non-empty description, preserve it and skip any rewriting later.
      $api_key_element_name = 'api_key_' . $provider_id;
      if (!empty($provider_settings[$api_key_element_name]) && !empty($provider_settings[$api_key_element_name]['#description'])) {
        $provider_settings[$api_key_element_name]['#preserve_description'] = TRUE;
      }

      // Detect whether the provider module inserted its own api_key element.
      $api_key_element_name = 'api_key_' . $provider_id;
      $provider_added_element = !empty($form['providers'][$provider_id . '_settings'][$api_key_element_name]);
      if ($provider_added_element) {
        // Mark provider-added element so we don't touch its description later.
        $form['providers'][$provider_id . '_settings'][$api_key_element_name]['#preserve_description'] = TRUE;
      }

      // Add API key field if the provider has a key_url
      // If the provider module hasn't already inserted a custom API key field
      // via the alter hook, add a default key_select. This preserves provider
      // customizations such as custom '#title' values (e.g., 'OpenRouter API Key').
      if (!empty($provider_info['key_url']) && empty($form['providers'][$provider_id . '_settings'][$api_key_element_name])) {
        $key_title = !empty($provider_info['key_label']) ? $provider_info['key_label'] : t('API Key');
        $form['providers'][$provider_id . '_settings'][$api_key_element_name] = [
          '#type' => 'key_select',
          '#title' => $key_title,
          '#default_value' => !empty($providers_root[$provider_id]['api_key']) ? $providers_root[$provider_id]['api_key'] : '',
          '#options' => $available_keys,
          '#key_filters' => ['type' => 'authentication'],
          // Intentionally leave description empty here; we'll set it below
          // to ensure the Key module's generic helper text is not shown.
          '#description' => '',
          '#weight' => -5,
        ];
        // We created this element; mark that provider did NOT add it.
        $provider_added_element = FALSE;
      }

      // If the provider advertises a key_url, prefer showing that as the
      // description so provider-specific guidance is the visible text.
      if (!empty($provider_info['key_url']) && !empty($form['providers'][$provider_id . '_settings'][$api_key_element_name])) {
        // Overwrite any helper text with a concise provider-specific link.
        $form['providers'][$provider_id . '_settings'][$api_key_element_name]['#description'] = t('Get your API key from <a href="@url" target="_blank">@url</a>', ['@url' => $provider_info['key_url']]);

        // Mark it so any later walkers don't re-rewrite it.
        $form['providers'][$provider_id . '_settings'][$api_key_element_name]['#preserve_description'] = TRUE;
      }

      // Read provider API key from the central providers mapping only
      $provider_key = '';
      if (!empty($providers_root[$provider_id]['api_key'])) {
        $provider_key = $providers_root[$provider_id]['api_key'];
      }

      // Only attempt to fetch models when the provider is enabled (default).
      if (!empty($default_enabled)) {
        $models = [];
        try {
          // Try adapter first (may not require central key storage).
          $api = openai_get_api($provider_id);
          if ($api) {
            $models = $api->getModels();
          }
          // Fallback to creating API client from configured key name.
          elseif (!empty($provider_key)) {
            $apiKey = key_get_key_value($provider_key);
            if (!empty($apiKey)) {
              $api = new OpenAIApi($apiKey, $provider_id);
              $models = $api->getModels();
            }
          }

          if (!empty($models)) {
            $form['providers'][$provider_id . '_settings'][$provider_id . '_models'] = [
              '#type' => 'markup',
              '#markup' => '<details class="provider-models"><summary><strong>' . check_plain($provider_info['label']) . ' — ' . t('@count models', ['@count' => count($models)]) . '</strong></summary>' .
                '<div style="max-height: 300px; overflow-y: auto; font-size: 0.9em; line-height: 1.4; padding:0.5em 0;">' .
                implode('<br/>', array_map('check_plain', $models)) .
                '</div></details>',
              '#weight' => 10,
            ];
          }
          else {
            // No models returned; do not fail silently — show a subtle notice
            // so admins can check credentials or provider availability.
            $notice = t('No models were returned by the provider @provider. Check the provider settings or credentials.', ['@provider' => check_plain($provider_info['label'])]);
            $form['providers'][$provider_id . '_settings'][$provider_id . '_models'] = [
              '#type' => 'markup',
              '#markup' => '<div class="description">' . $notice . '</div>',
              '#weight' => 10,
            ];
          }
        }
        catch (Exception $e) {
          // Surface authentication/HTTP errors clearly in the settings UI.
          watchdog('openai', 'Failed to fetch models for provider @provider: @msg', ['@provider' => $provider_id, '@msg' => $e->getMessage()], WATCHDOG_WARNING);

          $err = $e->getMessage();
          // Friendly admin message for common auth problems.
          if (preg_match('/401|unauthori|invalid|no cookie auth|credentials|forbidden/i', $err)) {
            $friendly = t('Authentication failed for provider @provider. Please verify the selected API key in OpenAI settings.', ['@provider' => check_plain($provider_info['label'])]);
          }
          else {
            $friendly = t('Error fetching models for provider @provider: @message', ['@provider' => check_plain($provider_info['label']), '@message' => check_plain($err)]);
          }

          $form['providers'][$provider_id . '_settings'][$provider_id . '_models'] = [
            '#type' => 'markup',
            '#markup' => '<div class="error">' . $friendly . '</div>',
            '#weight' => 10,
          ];
        }
      }
    }
  }

  $form['actions'] = ['#type' => 'actions'];
  $form['actions']['submit'] = [
    '#type' => 'submit',
    '#value' => t('Save configuration'),
  ];

  // Remove the Key module's generic helper sentence from key_select
  // descriptions on this settings page so provider-specific guidance
  // (e.g., "Store your OpenRouter API key...") remains the visible text.
  $walker = function (&$element) use (&$walker) {
    if (!is_array($element)) {
      return;
    }
    foreach ($element as $k => &$v) {
      if (!is_array($v)) {
        continue;
      }
      // If a provider marked this element to preserve its description,
      // strip only the generic Key helper sentence but otherwise preserve
      // the provider text. This ensures provider guidance remains while
      // removing the redundant helper.
      if (!empty($v['#preserve_description']) && !empty($v['#description']) && is_string($v['#description'])) {
        $pattern_preserve = '#Choose an available key\.\s*If the desired key is not listed, create a new key\.#is';
        $new_desc = preg_replace($pattern_preserve, '', $v['#description']);
        $new_desc = preg_replace('/^\s*[-:\s]*/', '', $new_desc);
        $v['#description'] = trim($new_desc);
      }

      if (!empty($v['#type']) && $v['#type'] === 'key_select' && !empty($v['#description'])) {
        // Remove the generic Key helper sentence even if there are
        // intervening line breaks or extra whitespace. Leave the rest
        // of the description intact (provider-specific guidance).
        $desc = $v['#description'];
        // Regex matches: "Choose an available key. [optional whitespace/newlines] If the desired key is not listed, create a new key." (case-insensitive)
        $pattern = '#Choose an available key\.\s*If the desired key is not listed, create a new key\.#is';
        $new = preg_replace($pattern, '', $desc);
        // Normalize whitespace and trim leading punctuation/spaces.
        $new = preg_replace('/^\s*[-:\s]*/', '', $new);
        $v['#description'] = trim($new);
      }
      $walker($v);
    }
  };
  $walker($form);

  // Final sanitization: ensure the generic Key helper sentence is removed
  // from any string in the render array (covers cases where a provider or
  // the Key module placed it outside '#description'). This only affects
  // the settings form render array in memory and is safe.
  $sanitize = function (&$value) use (&$sanitize) {
    if (is_array($value)) {
      foreach ($value as &$v) {
        $sanitize($v);
      }
      return;
    }
    if (!is_string($value)) {
      return;
    }
    $pattern = '#Choose an available key\.\s*If the desired key is not listed, create a new key\.#is';
    $new = preg_replace($pattern, '', $value);
    $new = preg_replace('/^\s*[-:\s]*/', '', $new);
    $value = trim($new);
  };
  $sanitize($form);

  return $form;
}

/**
 * Submit handler for openai_settings_form().
 */
function openai_settings_form_submit($form, &$form_state) {
  $config = config('openai.settings');
  $providers = openai_get_providers();

  $providers_values = [];
  if (!empty($form_state['values']['providers']) && is_array($form_state['values']['providers'])) {
    $providers_values = $form_state['values']['providers'];
  }

  // Read existing providers config
  $providers_root = $config->get('providers') ?: [];

  // Handle built-in OpenAI provider (not exposed via hook_openai_provider_info)
  $openai_enabled = !empty($providers_values['enabled_providers_openai']);
  if (!isset($providers_root['openai']) || !is_array($providers_root['openai'])) {
    $providers_root['openai'] = [];
  }
  $providers_root['openai']['enabled'] = $openai_enabled ? 1 : 0;

  // Persist OpenAI API key
  if (!empty($providers_values['openai_settings']['api_key_openai'])) {
    $providers_root['openai']['api_key'] = $providers_values['openai_settings']['api_key_openai'];
  }

  // Handle providers from hook_openai_provider_info
  foreach ($providers as $provider_id => $provider_info) {
    $checkbox_key = 'enabled_providers_' . $provider_id;
    $enabled = !empty($providers_values[$checkbox_key]);

    if (!isset($providers_root[$provider_id]) || !is_array($providers_root[$provider_id])) {
      $providers_root[$provider_id] = [];
    }
    $providers_root[$provider_id]['enabled'] = $enabled ? 1 : 0;

    // Persist API key (if provider exposes it in provider settings)
    $api_key_field = 'api_key_' . $provider_id;
    if (!empty($providers_values[$provider_id . '_settings'][$api_key_field])) {
      $providers_root[$provider_id]['api_key'] = $providers_values[$provider_id . '_settings'][$api_key_field];
    }

    // Persist other provider-specific settings (e.g., Ollama base_url)
    if (!empty($providers_values[$provider_id . '_settings']) && is_array($providers_values[$provider_id . '_settings'])) {
      foreach ($providers_values[$provider_id . '_settings'] as $k => $v) {
        if ($k === $api_key_field || $k === 'api_key') {
          continue;
        }
        $providers_root[$provider_id][$k] = $v;
      }
    }
  }

  // Save providers config only (single source of truth)
  $config->set('providers', $providers_root);

  // Save logging settings
  $config->set('openai_log_enabled', (bool) $form_state['values']['openai_log_enabled']);
  $config->set('openai_log_max_age', (int) $form_state['values']['openai_log_max_age']);

  $config->save();

  backdrop_set_message(t('Provider settings saved successfully.'));

  // Rebuild form so models list updates according to new enabled flags.
  $form_state['rebuild'] = TRUE;
}

/**
 * Get all chat models from all enabled providers.
 *
 * @return array
 *   Array of model options grouped by provider, suitable for select elements.
 *   Model keys are in format "provider_id/model_id" so the provider can be
 *   determined when the model is selected in a form.
 */
function openai_get_all_chat_models() {
  $models = [];
  $providers_root = config_get('openai.settings', 'providers') ?: [];

  foreach ($providers_root as $provider_id => $provider_config) {
    if (empty($provider_config['enabled'])) {
      continue;
    }

    // Initialize provider_models for each provider to avoid carryover
    $provider_models = [];

    try {
      $provider_api = openai_get_api($provider_id);
      if (!$provider_api) {
        // Fallback: attempt provider-specific helper function (e.g., openai_ollama_get_models)
        $fallback_models = [];
        $fn1 = 'openai_' . $provider_id . '_get_models';
        $fn2 = 'openai_' . $provider_id . '_fetch_models';
        if (function_exists($fn1)) {
          // Try to pass a base URL if the provider has one configured.
          $base = !empty($provider_config[$provider_id . '_base_url']) ? $provider_config[$provider_id . '_base_url'] : (!empty($provider_config['base_url']) ? $provider_config['base_url'] : NULL);
          try {
            $fallback_models = $base ? $fn1($base) : $fn1();
          } catch (Exception $e) { $fallback_models = $fn1(); }
        }
        elseif (function_exists($fn2)) {
          $base = !empty($provider_config[$provider_id . '_base_url']) ? $provider_config[$provider_id . '_base_url'] : (!empty($provider_config['base_url']) ? $provider_config['base_url'] : NULL);
          try {
            $fallback_models = $base ? $fn2($base) : $fn2();
          } catch (Exception $e) { $fallback_models = $fn2(); }
        }
        if (!empty($fallback_models)) {
          $provider_models = $fallback_models;
        }
        else {
          continue;
        }
      }

      // Support adapters that expose getChatModels() or getModels().
      if (empty($provider_models) && !empty($provider_api)) {
        try {
          if (method_exists($provider_api, 'getChatModels')) {
            $provider_models = $provider_api->getChatModels();
          }
          elseif (method_exists($provider_api, 'getModels')) {
            $provider_models = $provider_api->getModels();
          }
        }
        catch (Exception $e) {
          // Adapter failed; log and attempt fallback helpers below.
          watchdog('openai', 'Provider adapter @provider failed to list models: @msg', ['@provider' => $provider_id, '@msg' => $e->getMessage()], WATCHDOG_WARNING);
          $provider_models = [];
        }

        // If adapter returned no models, try provider-specific helpers.
        if (empty($provider_models)) {
          $fn1 = 'openai_' . $provider_id . '_get_models';
          $fn2 = 'openai_' . $provider_id . '_fetch_models';
          $fallback_models = [];
          if (function_exists($fn1)) {
            $base = !empty($provider_config[$provider_id . '_base_url']) ? $provider_config[$provider_id . '_base_url'] : (!empty($provider_config['base_url']) ? $provider_config['base_url'] : NULL);
            try { $fallback_models = $base ? $fn1($base) : $fn1(); } catch (Exception $e) { $fallback_models = $fn1(); }
          }
          elseif (function_exists($fn2)) {
            $base = !empty($provider_config[$provider_id . '_base_url']) ? $provider_config[$provider_id . '_base_url'] : (!empty($provider_config['base_url']) ? $provider_config['base_url'] : NULL);
            try { $fallback_models = $base ? $fn2($base) : $fn2(); } catch (Exception $e) { $fallback_models = $fn2(); }
          }
          if (!empty($fallback_models)) {
            $provider_models = $fallback_models;
          }
        }
      }

      if (!empty($provider_models)) {
        $provider_label = openai_get_provider_label($provider_id);
        foreach ($provider_models as $model_id => $model_name) {
          // provider_models entries can be in several shapes:
          // - associative: id => label
          // - indexed strings: [0 => 'gemma3:latest', ...]
          // - indexed arrays: [0 => ['id'=>'gemma3:latest','owned_by'=>'library'], ...]
          if (is_int($model_id)) {
            // Indexed array; $model_name may be string or array
            if (is_array($model_name)) {
              $canonical_id = isset($model_name['id']) ? (string) $model_name['id'] : (isset($model_name['name']) ? (string) $model_name['name'] : json_encode($model_name));
              $label = !empty($model_name['display_name']) ? $model_name['display_name'] : $canonical_id;
            }
            else {
              $canonical_id = (string) $model_name;
              $label = $canonical_id;
            }
          }
          else {
            // Associative: key is model id, value may be label or array
            $canonical_id = (string) $model_id;
            if (is_array($model_name)) {
              $label = !empty($model_name['display_name']) ? $model_name['display_name'] : (!empty($model_name['id']) ? $model_name['id'] : json_encode($model_name));
            }
            else {
              $label = (string) $model_name;
            }
          }
          // Build prefixed ID and label with provider prefix
          $prefixed_id = $provider_id . '/' . $canonical_id;
          $models[$provider_label][$prefixed_id] = $label;
        }
      }
    }
    catch (Exception $e) {
      watchdog('openai', 'Failed to fetch chat models from @provider: @message', [
        '@provider' => $provider_id,
        '@message' => $e->getMessage(),
      ], WATCHDOG_WARNING);
    }
  }

  // Sort providers alphabetically
  ksort($models);

  return $models;
}

/**
 * Fetches available models from OpenAI.
 *
 * @return array
 *   A list of models or an empty array if unavailable.
 */
function openai_fetch_available_models() {
  try {
    $apiKey = key_get_key_value(config('openai.settings')->get('api_key'));
    if (empty($apiKey) || !is_string($apiKey)) {
      watchdog('openai', 'The API key could not be retrieved or is invalid.', [], WATCHDOG_ERROR);
      return [];
    }
    $api = new OpenAIApi($apiKey);
    return $api->getModels();
  }
  catch (Exception $e) {
    watchdog('openai', 'Failed to fetch models: @message', ['@message' => $e->getMessage()], WATCHDOG_ERROR);
    return [];
  }
}

/**
 * Get all image generation models from all enabled providers.
 *
 * NOTE: Only OpenAI can reliably filter models by capability. For Ollama and
 * OpenRouter, we return ALL models since they cannot sort by capability.
 *
 * @return array
 *   Array of model options grouped by provider, suitable for select elements.
 */
function openai_get_all_image_models() {
  $models = [];
  $providers_root = config_get('openai.settings', 'providers') ?: [];

  foreach ($providers_root as $provider_id => $provider_config) {
    if (empty($provider_config['enabled'])) {
      continue;
    }

    try {
      $provider_api = openai_get_api($provider_id);
      if (!$provider_api) {
        continue;
      }

      // Only OpenAI can reliably filter by image capability
      if ($provider_id === 'openai') {
        $provider_models = $provider_api->getImageModels();
      } else {
        // For Ollama/OpenRouter: return ALL models, they can't sort reliably
        $provider_models = $provider_api->getModels();
      }

      if (!empty($provider_models)) {
        $provider_label = openai_get_provider_label($provider_id);
        foreach ($provider_models as $model_id => $model_name) {
          $prefixed_id = $provider_id . '/' . $model_id;
          $models[$provider_label][$prefixed_id] = $model_name;
        }
      }
    }
    catch (Exception $e) {
      watchdog('openai', 'Failed to fetch image models from @provider: @message', [
        '@provider' => $provider_id,
        '@message' => $e->getMessage(),
      ], WATCHDOG_WARNING);
    }
  }

  ksort($models);

  return $models;
}

