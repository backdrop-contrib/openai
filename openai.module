/**
 * Get a human-readable label for a provider.
 *
 * @param string $provider_id
 *   The provider ID (e.g., 'openai', 'openrouter', 'ollama', 'litellm').
 *
 * @return string
 *   The display label for the provider.
 */
function openai_get_provider_label($provider_id) {
  // First, ask provider modules for their labels via hook_openai_provider_info().
  // Prefer provider modules and central config. Do NOT force-merge the
  // built-in OpenAI provider here — the site config determines which
  // providers are available.
  $providers = openai_get_providers();
  if (!empty($providers[$provider_id]['label'])) {
    return $providers[$provider_id]['label'];
  }

  // Next, check the central openai.settings providers mapping for a label.
  $providers_root = config_get('openai.settings', 'providers') ?: [];
  if (!empty($providers_root[$provider_id]['label'])) {
    return $providers_root[$provider_id]['label'];
  }

  // Final fallback: humanize the provider_id.
  return ucfirst($provider_id);
}

/**
 * Get an API instance for a specific provider.
 *
 * @param string $provider_id
 *   The provider ID (e.g., 'openai', 'openrouter', 'ollama', 'litellm').
 *
 * @return OpenAIApi|null
 *   The API instance or NULL if not available.
 */
function openai_get_api($provider_id = 'openai') {
  // Read API key from central providers mapping only
  $providers_root = config_get('openai.settings', 'providers') ?: [];
  $api_key_name = '';

  if (!empty($providers_root[$provider_id]['api_key'])) {
    $api_key_name = $providers_root[$provider_id]['api_key'];
  }

  // If the provider exposes a pluggable adapter class via hook, prefer
  // instantiating that class (it may not require an API key, e.g., Ollama).
  $providers_info = openai_get_providers();
  if (!empty($providers_info[$provider_id]) && !empty($providers_info[$provider_id]['class'])) {
    $class = $providers_info[$provider_id]['class'];
    // Attempt to autoload the adapter from the provider module if present.
    $provider_module = 'openai_' . $provider_id;
    // Try to include the expected file includes/{Class}.php in the provider module.
    if (!class_exists($class) && module_exists($provider_module)) {
      @module_load_include('php', $provider_module, 'includes/' . $class);
    }

    if (class_exists($class)) {
      // Instead of returning the raw adapter instance (which bypasses the
      // OpenAIApi wrapper and therefore logging), return an OpenAIApi
      // instance that will initialize the provider adapter internally.
      try {
        // Resolve the API key value (may be NULL) to pass into the wrapper.
        $api_key = NULL;
        if (!empty($api_key_name)) {
          $api_key = key_get_key_value($api_key_name);
        }
        return new OpenAIApi($api_key ?: '', $provider_id);
      }
      catch (Exception $e) {
        watchdog('openai', 'Failed to instantiate OpenAIApi wrapper for @provider using adapter @class: @msg', ['@provider' => $provider_id, '@class' => $class, '@msg' => $e->getMessage()], WATCHDOG_WARNING);
        // fallback to API wrapper below if possible
      }
    }
  }

  if (empty($api_key_name)) {
    return NULL;
  }

  try {
    $api_key = key_get_key_value($api_key_name);
    if (empty($api_key)) {
      return NULL;
    }

    return new OpenAIApi($api_key, $provider_id);
  }
  catch (Exception $e) {
    watchdog('openai', 'Failed to create API instance for @provider: @message', [
      '@provider' => $provider_id,
      '@message' => $e->getMessage(),
    ], WATCHDOG_WARNING);
    return NULL;
  }
}

/**
 * Get an OpenAI API instance for a given model ID.
 *
 * @param string $model_id
 *   The model ID, optionally prefixed with provider.
 * @param string &$stripped_model_id
 *   (Optional) Will be set to the model ID with the provider prefix removed.
 *
 * @return OpenAIApi|null
 *   The API instance configured for the correct provider, or NULL if unavailable.
 */
function openai_get_api_for_model($model_id, &$stripped_model_id = NULL) {
  if (empty($model_id)) {
    return NULL;
  }

  $provider = NULL;
  $model_without_provider = $model_id;

  if (strpos($model_id, '/') !== FALSE) {
    $parts = explode('/', $model_id, 2);
    $provider = $parts[0];
    $model_without_provider = $parts[1];
  }

  $stripped_model_id = $model_without_provider;

  if (!empty($provider)) {
    $api = openai_get_api($provider);
    if ($api) {
      return $api;
    }
    watchdog('openai', 'Model @model specifies provider @provider but that provider is not configured.', [
      '@model' => $model_id,
      '@provider' => $provider,
    ], WATCHDOG_WARNING);
  }

  return openai_get_api('openai');
}

/**
 * Wrapper function for chat completions.
 */
function openai_chat($model, array $messages, $temperature = 0.7, $max_tokens = 1024, $stream_response = FALSE) {
  $stripped_model = '';
  $api = openai_get_api_for_model($model, $stripped_model);

  if (!$api) {
    throw new Exception(t('No API provider is configured for model @model.', ['@model' => $model]));
  }

  return $api->chat($stripped_model, $messages, $temperature, $max_tokens, $stream_response);
}

/**
 * Wrapper function for content moderation.
 */
function openai_moderation($input, $model = 'omni-moderation-latest') {
  $stripped_model = '';
  $api = openai_get_api_for_model($model, $stripped_model);

  if (!$api) {
    throw new Exception(t('No API provider is configured for moderation.'));
  }

  return $api->moderation($input, $stripped_model);
}

/**
 * Get all embedding models from all enabled providers with dimension info.
 */
function openai_get_all_embedding_models_with_dimensions() {
  $models = [];
  $providers_root = config_get('openai.settings', 'providers') ?: [];

  foreach ($providers_root as $provider_id => $provider_config) {
    if (empty($provider_config['enabled'])) {
      continue;
    }

    try {
      $provider_api = openai_get_api($provider_id);
      if (!$provider_api) {
        continue;
      }

      $provider_models = $provider_api->getEmbeddingModels();
      if (!empty($provider_models)) {
        foreach ($provider_models as $model_id => $model_name) {
          $dimension = openai_get_embedding_dimension($model_id, $provider_id);

          // Only include models that actually support embeddings (dimension > 0)
          // Note: `openai_get_embedding_dimension()` currently falls back to 1536
          // when dynamic detection fails. That means unknown or unsupported
          // models may appear to have a nonzero dimension and won't be
          // excluded by this check. If the intent is to only include models
          // with a known/confirmed embedding dimension, use
          // `openai_detect_embedding_dimension()` here or update
          // `openai_get_embedding_dimension()` to return 0 when detection
          // fails and there is no known override.
          if ($dimension <= 0) {
            continue;
          }

          // Prefix model ID with provider to create fully-qualified name
          $qualified_id = $provider_id . '/' . $model_id;

          $models[$qualified_id] = [
            'name' => $model_name,
            'provider' => $provider_id,
            'dimension' => $dimension,
            'label' => $model_name . ' (' . openai_get_provider_label($provider_id) . ')',
          ];
        }
      }
    }
    catch (Exception $e) {
      watchdog('openai', 'Failed to fetch embedding models from @provider: @message', [
        '@provider' => $provider_id,
        '@message' => $e->getMessage(),
      ], WATCHDOG_WARNING);
    }
  }

  return $models;
}

/**
 * Get the dimension for a specific embedding model.
 *
 * This function first attempts to detect the dimension dynamically by making
 * a test API call, then falls back to known dimensions, and finally to a
 * default of 1536.
 *
 * @param string $model_id
 *   The model ID (may include provider prefix).
 * @param string $provider_id
 *   The provider ID.
 *
 * @return int
 *   The embedding dimension.
 */
function openai_get_embedding_dimension($model_id, $provider_id = 'openai') {
  // Try dynamic detection first
  $dynamic_dimension = openai_detect_embedding_dimension($model_id, $provider_id);
  if ($dynamic_dimension > 0) {
    $dimension = $dynamic_dimension;
  }
  else {
    // Fall back to known dimensions for common models
    $known_dimensions = [
      'text-embedding-ada-002' => 1536,
      'text-embedding-3-small' => 1536,
      'text-embedding-3-large' => 3072,
      'openai/text-embedding-3-large' => 3072,
      'openai/text-embedding-3-small' => 1536,
      'openai/text-embedding-ada-002' => 1536,
      'voyage-ai/voyage-3' => 1024,
      'voyage-ai/voyage-3-lite' => 512,
      'cohere/embed-english-v3.0' => 1024,
      'cohere/embed-multilingual-v3.0' => 1024,
    ];

    if (isset($known_dimensions[$model_id])) {
      $dimension = $known_dimensions[$model_id];
    }
    else {
      $dimension = 1536;
    }
  }

  // Allow site-specific overrides
  backdrop_alter('openai_embedding_dimension', $dimension, $model_id, $provider_id);

  return $dimension;
}

/**
 * Dynamically detect embedding dimension by making a test API call.
 *
 * @param string $model_id
 *   The model ID.
 * @param string $provider_id
 *   The provider ID.
 *
 * @return int
 *   The detected dimension, or 0 if detection failed.
 */
function openai_detect_embedding_dimension($model_id, $provider_id) {
  $cache_key = "embedding_dim:{$provider_id}:{$model_id}";
  $cached = cache_get($cache_key);
  if ($cached && !empty($cached->data)) {
    return (int) $cached->data;
  }

  try {
    $api = openai_get_api($provider_id);
    if (!$api) {
      return 0;
    }

    // Suppress watchdog errors for this specific check to avoid log spam
    // when checking models that don't support embeddings.
    $test_embedding = $api->embedding("test", $model_id, FALSE);
    if (empty($test_embedding) || !is_array($test_embedding)) {
      // If detection failed, cache a 0 for a shorter time to avoid repeated failed calls
      cache_set($cache_key, 0, 'cache', time() + 3600);
      return 0;
    }

    $dimension = count($test_embedding);
    if ($dimension > 0) {
      cache_set($cache_key, $dimension, 'cache', time() + 86400);
      return $dimension;
    }
  }
  catch (Exception $e) {
    watchdog('openai', 'Failed to detect embedding dimension for @model: @error', [
      '@model' => $model_id,
      '@error' => $e->getMessage(),
    ], WATCHDOG_DEBUG);
  }

  return 0;
}

/**
 * Implements hook_openai_provider_info().
 *
 * Advertise the built-in OpenAI provider so it appears in module_invoke_all()
 * results alongside pluggable providers like Ollama / OpenRouter.
 */
function openai_openai_provider_info() {
  return [
    'openai' => [
      'label' => t('OpenAI'),
      'description' => t('Official OpenAI provider (GPT, DALL·E, etc.).'),
      'website' => 'https://platform.openai.com/',
      'key_url' => 'https://platform.openai.com/account/api-keys',
    ],
  ];
}

/**
 * Return all provider info, optionally ensuring the built-in OpenAI provider is present.
 *
 * @param bool $include_builtin
 *   If TRUE, merge the built-in OpenAI provider info into the result if it
 *   isn't already present. Defaults to FALSE to avoid advertising the built-in
 *   provider when it should be hidden.
 *
 * @return array
 *   Provider info keyed by provider id.
 */
function openai_get_providers($include_builtin = FALSE) {
  $providers = module_invoke_all('openai_provider_info');
  if ($include_builtin && empty($providers['openai']) && function_exists('openai_openai_provider_info')) {
    $builtin = openai_openai_provider_info();
    if (!empty($builtin['openai'])) {
      $providers['openai'] = $builtin['openai'];
    }
  }

  // Sort providers alphabetically by label
  uasort($providers, function($a, $b) {
    $label_a = isset($a['label']) ? (string)$a['label'] : '';
    $label_b = isset($b['label']) ? (string)$b['label'] : '';
    return strcasecmp($label_a, $label_b);
  });

  return $providers;
}
